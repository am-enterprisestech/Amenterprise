# ---------------------------------------------------------------------------
# AM Enterprises — environment variables
# Copy to `.env` for local development and add the same keys to
# Vercel / hosting provider settings.
# Never commit real secrets to version control.
# ---------------------------------------------------------------------------

# Frontend / Browser Supabase Credentials
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
VITE_SUPABASE_PROJECT_ID=your_project_id_here

# Server-side Supabase & Database Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ---------------------------------------------------------------------------
# Chatbot (SERVER-SIDE ONLY — no VITE_ prefix, never reaches the browser)
# ---------------------------------------------------------------------------
CHATBOT_API_KEY=your_api_key_here
CHATBOT_MODEL=gemini-2.5-flash
CHATBOT_API_URL=https://api.openai.com/v1/chat/completions
