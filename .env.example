# ---------------------------------------------------------------------------
# AM Enterprises — Environment Variables
# Copy this file to `.env` for local development.
# Add the same keys to Vercel → Project → Settings → Environment Variables
# (Production + Preview). NEVER commit real secrets.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# SUPABASE — Frontend (safe to expose, publishable keys used by the browser)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_key_here
VITE_SUPABASE_PROJECT_ID=your_project_id_here

# Same values read by server-side rendering / server routes (no VITE_ prefix)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_anon_key_here

# Service-role key — SERVER ONLY. Used by admin server functions to bypass RLS.
# Never prefix with VITE_. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ---------------------------------------------------------------------------
# DATABASE MIGRATIONS (Drizzle Kit)
# Used only when running: npx drizzle-kit push
# ---------------------------------------------------------------------------
LOVABLE_DB_MIGRATION_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres

# ---------------------------------------------------------------------------
# AI CHATBOT — SERVER-SIDE ONLY (no VITE_ prefix, never reaches the browser)
# The key is read only inside src/routes/api/chat.ts
# ---------------------------------------------------------------------------
CHATBOT_API_KEY=your_openrouter_or_openai_key_here

# Optional overrides (defaults shown)
# CHATBOT_MODEL=google/gemini-2-flash-lite
# CHATBOT_API_URL=https://ai.gateway.lovable.dev/v1/chat/completions

# ---------------------------------------------------------------------------
# EMAIL SENDING (Resend) — SERVER-SIDE ONLY
# Used by src/routes/api/send-email.ts for notifications, support replies etc.
# Get your key at https://resend.com
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=AM Enterprises <no-reply@amenterprise.tech>

# ---------------------------------------------------------------------------
# STORAGE — Supabase Storage is used by default.
# If you want a custom CDN prefix for uploaded files, set this:
# ---------------------------------------------------------------------------
# STORAGE_PUBLIC_URL=https://your-project.supabase.co/storage/v1/object/public

# ---------------------------------------------------------------------------
# SITE / APP
# ---------------------------------------------------------------------------
VITE_SITE_URL=https://www.amenterprise.tech

# ---------------------------------------------------------------------------
# OPTIONAL — Lovable / AI gateway fallback keys (auto-injected on Lovable hosting)
# ---------------------------------------------------------------------------
# LOVABLE_API_KEY=auto_injected_on_lovable
# AI_GATEWAY_API_KEY=auto_injected_on_lovable
